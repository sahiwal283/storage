# /etc/storage-app.env — storage app configuration
SERVICE_URL=http://192.168.1.205:8000
INTERNAL_TOKEN=<storage-app bearer token from zoho-integration-service>
BRANDS=[{"code":"haute_brands","name":"Haute Brands"},{"code":"boomin_brands","name":"Boomin Brands"},{"code":"nirvana_kulture","name":"Nirvana Kulture"}]
OIDC_ISSUER=https://auth.booute.duckdns.org/application/o/storage
OIDC_CLIENT_ID=<authentik client id>
OIDC_CLIENT_SECRET=<authentik client secret>
PUBLIC_URL=https://storage.booute.duckdns.org
SECRET_KEY=<random 64 hex chars>
